# Git Ignore Configuration

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
build/
dist/
*.egg-info/

# ML / PyTorch / TensorFlow
.ipynb_checkpoints/
runs/
wandb/
mlruns/
checkpoints/
models/checkpoints/
*.onnx
*.h5
*.ckpt
# NOTE: *.pt and *.pth are tracked via Git LFS (not ignored)
# so model weights are available for cloud deployment on Render/Railway

# Data
data/raw/
data/processed/
*.csv
!models/*.json
!configs/*.yaml

# Frontend
node_modules/
dist/
build/
.next/
.cache/

# Environment/Secrets
.env
.env.*
!.env.example
secrets.json

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs & Temp
*.log
tmp/
temp/
.pytest_cache/
.coverage
htmlcov/

# Results/Generated Artifacts
results/
research/figures/
